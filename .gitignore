# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
backend/.pytest_cache/

# Node / frontend build
# No trailing slash on node_modules: a symlinked `node_modules` (how a git
# worktree shares one install with the main checkout) is a symlink to git, not a
# directory, and `node_modules/` does not match it. Committing one leaves a
# broken absolute path in the tree on every other machine.
node_modules
dist/
frontend/dist/

# App data (SQLite + data files)
dat_distiller_data/

# OS
.DS_Store

# Playwright (issue #44): the suite runs in a real browser against a real server
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
.e2e-data/
